# 複製成 .env 後填入實際值：cp .env.example .env
# langgraph dev、patrol.py、scripts/mcp.sh 都讀這個檔案

# ===== 模型（provider:model 格式）=====
# 例：openai:gpt-5.2、anthropic:claude-sonnet-5-5
PATROL_MODEL=openai:gpt-5.2
OPENAI_API_KEY=
# 使用 OpenAI 相容端點時填寫（例如自架或代理服務）
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# ANTHROPIC_API_KEY=

# ===== 選用資料來源（預設關閉）=====
ENABLE_ELASTICSEARCH=false
ENABLE_DYNATRACE=false

# ===== Kubernetes MCP（固定啟用）=====
K8S_MCP_URL=http://localhost:18080/mcp
# 留空使用 $KUBECONFIG 或 ~/.kube/config；建議使用只有讀取權限的 kubeconfig
K8S_MCP_KUBECONFIG=
K8S_MCP_PORT=18080

# ===== Prometheus MCP（固定啟用）=====
PROM_MCP_URL=http://localhost:18090/mcp
PROM_MCP_PORT=18090
# MCP server 跑在 Docker 裡：Prometheus 在本機時請用 http://host.docker.internal:9090
PROMETHEUS_URL=http://host.docker.internal:9090
# 依需要擇一填寫認證
# PROMETHEUS_USERNAME=
# PROMETHEUS_PASSWORD=
# PROMETHEUS_TOKEN=

# ===== Elasticsearch MCP（ENABLE_ELASTICSEARCH=true 時使用）=====
ES_MCP_URL=http://localhost:18100/mcp
ES_MCP_PORT=18100
ES_URL=https://your-elasticsearch:9200
# 認證擇一：API key 或帳號密碼（建議使用唯讀權限）
ES_API_KEY=
# ES_USERNAME=
# ES_PASSWORD=
# ES_SSL_SKIP_VERIFY=false
# K8s 日誌的 index pattern，例如 logs-*、filebeat-*、k8s-logs-*
ES_INDEX_PATTERN=*

# ===== Dynatrace MCP（ENABLE_DYNATRACE=true 時使用）=====
DT_MCP_URL=http://localhost:18110/mcp
DT_MCP_PORT=18110
# SaaS：https://<env-id>.live.dynatrace.com
# Managed：https://<your-domain>/e/<env-id>
DT_BASE_URL=
# API token 只需要：problems.read、entities.read、metrics.read、events.read
DT_API_TOKEN=
# DT_SSL_VERIFY=true

# ===== 巡檢保護機制 =====
# 每批平行巡檢的 Deployment 數量
PATROL_BATCH_SIZE=3
# 每個 Deployment 最多委派幾輪
PATROL_MAX_ROUNDS_PER_DEPLOYMENT=2
# 整次巡檢的步數上限（LangGraph recursion_limit）
PATROL_RECURSION_LIMIT=300
# 預設查詢時間窗
PATROL_LOOKBACK=1h
# 單次工具結果最多回傳字元數
MCP_MAX_RESULT_CHARS=20000
MCP_TIMEOUT_SECONDS=60

# ===== patrol.py =====
LANGGRAPH_API_URL=http://localhost:2024
PATROL_ASSISTANT_ID=patrol_agent
# PATROL_REPORTS_DIR=../reports
